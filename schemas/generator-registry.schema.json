{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/generator-registry.schema.json",
  "title": "Free visual generator registry",
  "type": "object",
  "required": ["schemaVersion", "snapshotDate", "policy", "generators"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "snapshotDate": { "type": "string", "format": "date" },
    "policy": {
      "type": "object",
      "required": ["freeOnly", "paidPlanContentIncluded", "unknownOutputAction"]
    },
    "generators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "mode",
          "categories",
          "freeScope",
          "licenseOrTerms",
          "accountRequired",
          "outputPolicy",
          "privacy",
          "inclusion",
          "caveats",
          "verificationUrls"
        ]
      }
    }
  }
}
