{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wojciechmathea-hash/ui-motion-3d-knowledge-base/schemas/font-source-registry.schema.json",
  "title": "Open-source font source registry",
  "type": "object",
  "required": ["verifiedAt", "policy", "sources"],
  "properties": {
    "verifiedAt": { "type": "string", "format": "date" },
    "policy": {
      "type": "object",
      "required": ["openSourceOnly", "paidFontsAllowed", "mixedLicenseCatalogsAllowed", "selfHostPreferred", "perFamilyLicenseCheckRequired", "requiredGlyphs"],
      "properties": {
        "openSourceOnly": { "const": true },
        "paidFontsAllowed": { "const": false },
        "mixedLicenseCatalogsAllowed": { "const": false },
        "selfHostPreferred": { "type": "boolean" },
        "perFamilyLicenseCheckRequired": { "const": true },
        "requiredGlyphs": { "type": "array", "minItems": 18, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "repository", "licenseScope", "delivery", "bestFor", "requiredChecks", "inclusion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "repository": { "type": ["string", "null"], "format": "uri" },
          "licenseScope": { "type": "string", "minLength": 1 },
          "delivery": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "bestFor": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "requiredChecks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "inclusion": { "type": "string", "pattern": "^approved-" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
